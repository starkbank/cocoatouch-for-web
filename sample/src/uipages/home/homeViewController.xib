<div id="menu"></div>

<main class="page">
    <h1 id="home-title">CocoaTouch for Web</h1>
    <p id="home-subtitle" class="lead"></p>

    <div class="home-grid">
        <a id="home-buttons" class="home-option">
            <h3>Buttons</h3>
            <p>@IBAction, addTarget, keyboard shortcuts, isEnabled</p>
        </a>
        <a id="home-labels" class="home-option">
            <h3>Labels</h3>
            <p>text, textColor, isHidden, style, lifecycle and notifications</p>
        </a>
        <a id="home-text-fields" class="home-option">
            <h3>Text fields</h3>
            <p>placeholder, delegate, isSecureTextEntry, first responder</p>
        </a>
        <a id="home-custom-views" class="home-option">
            <h3>Custom views</h3>
            <p>A UIView subclass with its own nib, as an outlet and via addSubview</p>
        </a>
        <a id="home-table-view" class="home-option">
            <h3>Table view</h3>
            <p>A UITableView with a registered custom cell, data source and delegate</p>
        </a>
        <a id="home-links" class="home-option">
            <h3>Links and scrolling</h3>
            <p>userActivity as a link, UIImage(systemName:), UIScrollView offsets, key commands and text input</p>
        </a>
        <a id="home-traits" class="home-option">
            <h3>Traits</h3>
            <p>@IBInspectable from the nib, CGRect frames and bounds, size classes on resize</p>
        </a>
        <a id="home-navigation" class="home-option">
            <h3>Navigation</h3>
            <p>A UINavigationController: push and pop bound to browser history, with a navigation bar</p>
        </a>
    </div>
</main>
