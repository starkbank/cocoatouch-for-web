{
    "compilerOptions": {
        "allowJs": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "rootDir": "src",
        "outDir": "types",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "skipLibCheck": true
    },
    "include": ["src/**/*.js"]
}
